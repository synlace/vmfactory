{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmfactory.local/schemas/candidates/container-v1.schema.json",
  "title": "vmfactory Container CandidateSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "config"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "method": {
      "const": "container"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "needs_docker",
        "image_provenance"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "uniqueItems": true
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "memory_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 512
        },
        "needs_docker": {
          "type": "boolean",
          "const": true
        },
        "image_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "pull",
                "build"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "Registry/image reference for pull, or bounded build source identifier for build."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bin",
            "probes"
          ],
          "properties": {
            "kind": {
              "const": "cmd"
            },
            "bin": {
              "type": "string",
              "minLength": 1
            },
            "probes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "port"
          ],
          "properties": {
            "kind": {
              "const": "tcp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "protocol",
            "port",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "http"
            },
            "protocol": {
              "enum": [
                "http",
                "https"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      ]
    }
  }
}
