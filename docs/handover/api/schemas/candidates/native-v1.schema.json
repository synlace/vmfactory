{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmfactory.local/schemas/candidates/native-v1.schema.json",
  "title": "vmfactory Native CandidateSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "config"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "method": {
      "const": "native"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_image",
        "command"
      ],
      "properties": {
        "base_image": {
          "type": "string",
          "minLength": 1
        },
        "install": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "hold": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "memory_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 256
        }
      }
    }
  },
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bin",
            "probes"
          ],
          "properties": {
            "kind": {
              "const": "cmd"
            },
            "bin": {
              "type": "string",
              "minLength": 1
            },
            "probes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "exec"
            },
            "command": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "port"
          ],
          "properties": {
            "kind": {
              "const": "tcp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "protocol",
            "port",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "http"
            },
            "protocol": {
              "enum": [
                "http",
                "https"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      ]
    }
  }
}
