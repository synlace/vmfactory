{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmfactory.local/schemas/candidates/prebuilt-v1.schema.json",
  "title": "vmfactory Prebuilt CandidateSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "config"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "method": {
      "const": "prebuilt"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "enum": [
                "image",
                "archive",
                "binary"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        },
        "install": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "memory_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 256
        }
      }
    }
  },
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bin",
            "probes"
          ],
          "properties": {
            "kind": {
              "const": "cmd"
            },
            "bin": {
              "type": "string",
              "minLength": 1
            },
            "probes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "exec"
            },
            "command": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "port"
          ],
          "properties": {
            "kind": {
              "const": "tcp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "protocol",
            "port",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "http"
            },
            "protocol": {
              "enum": [
                "http",
                "https"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      ]
    }
  },
  "description": "Pre-resolved artefact candidate. For artifact.kind=image, the image is already resolved and this candidate must not define an image-production/build path."
}
