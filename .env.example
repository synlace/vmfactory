# vmf LLM assist configuration.
#
# This file is a template. The live config lives OUTSIDE the repo at
# ~/.vmf/env (chmod 600); vmf sources it per invocation. Process env
# wins over the file. No LLM path is mandatory: without a key every
# vmf run stays deterministic and degrades to the project menu.
#
# Copy the lines you need into ~/.vmf/env:
#   mkdir -p ~/.vmf && cp .env.example ~/.vmf/env
#   chmod 600 ~/.vmf/env

# OpenRouter API key (https://openrouter.ai/keys).
# OPENROUTER_API_KEY is accepted as an alias.
VMF_LLM_API_KEY=sk-or-v1-...

# Model ids. VMF_LLM_MODEL is the default; the two role knobs override
# it per role.
VMF_LLM_MODEL=z-ai/glm-5.3-flash
VMF_INTENT_MODEL=z-ai/glm-5.3-flash
VMF_GAPFILL_MODEL=z-ai/glm-5.3-flash

# Optional: any OpenAI-compatible endpoint (LM Studio, vLLM, ...).
# Empty = https://openrouter.ai/api/v1
#VMF_LLM_BASE_URL=http://127.0.0.1:1234/v1

# Context7 grounding (up-to-date docs for gap-fill spec'ing).
# Optional; without it the API allows limited anonymous use.
# https://context7.com/settings
#CONTEXT7_API_KEY=ctx7sk-...

# Optional: use a different file than ~/.vmf/env.
# VMF_ENV_FILE=~/.vmf/env