{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vmf refines",
  "description": "The bounded --intent overlay: validated replicas, env, and command overrides per plan service. The base plan and its cache stay untouched; flatten applies this deterministically.",
  "type": "object",
  "required": ["replicas", "env", "command"],
  "additionalProperties": false,
  "properties": {
    "replicas": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 2, "maximum": 12}
    },
    "env": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      }
    },
    "command": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "array", "minItems": 1, "maxItems": 16,
        "items": {"type": "string"}
      }
    }
  }
}