{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vmf plan",
  "description": "The canonical run plan produced by scripts/vmf_plan.py plan. One plan per run; the boot path only ever reads artifacts derived from it (manifest.json, flattened compose.yaml, ports.txt).",
  "type": "object",
  "required": ["compose_file", "project_dir", "primary", "services"],
  "additionalProperties": false,
  "properties": {
    "compose_file": {"type": "string"},
    "project_dir": {"type": "string"},
    "primary": {"type": "string", "minLength": 1},
    "services": {"type": "array", "minItems": 1, "maxItems": 12,
                 "items": {"$ref": "#/definitions/service"}},
    "checks": {"type": "array", "items": {"$ref": "#/definitions/check"}}
  },
  "definitions": {
    "port": {
      "type": "object",
      "required": ["host", "cport", "proto"],
      "additionalProperties": false,
      "properties": {
        "host": {"type": "integer", "minimum": 1, "maximum": 65535},
        "cport": {"type": "integer", "minimum": 1, "maximum": 65535},
        "proto": {"enum": ["tcp", "udp"]}
      }
    },
    "check": {
      "oneOf": [
        {"type": "object", "required": ["tcp"], "additionalProperties": false,
         "properties": {"tcp": {"type": "object", "required": ["port"],
           "additionalProperties": false,
           "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}}}},
        {"type": "object", "required": ["exec"], "additionalProperties": false,
         "properties": {"exec": {"type": "object", "required": ["cmd"],
           "additionalProperties": false,
           "properties": {"cmd": {"type": "string", "minLength": 1}}}}},
        {"type": "object", "required": ["probe"], "additionalProperties": false,
         "properties": {"probe": {"type": "object", "required": ["port"],
           "additionalProperties": false,
           "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535},
                          "path": {"type": "string"},
                          "expect_status": {"type": "integer", "minimum": 100, "maximum": 599},
                          "expect_contains": {"type": "string"}}}}},
        {"type": "object", "required": ["log"], "additionalProperties": false,
         "properties": {"log": {"type": "object", "required": ["match"],
           "additionalProperties": false,
           "properties": {"match": {"type": "string", "minLength": 1},
                          "within": {"type": "string"}}}}},
        {"type": "object", "required": ["rfb"], "additionalProperties": false,
         "properties": {"rfb": {"type": "object", "required": ["port"],
           "additionalProperties": false,
           "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}}}}
      ]
    },
    "build": {
      "type": "object",
      "required": ["context", "dockerfile"],
      "additionalProperties": false,
      "properties": {
        "context": {"type": "string"},
        "dockerfile": {"type": "string"},
        "args": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "ports", "env", "depends_on"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {},
        "entrypoint": {},
        "image": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "build": {"$ref": "#/definitions/build"},
        "ports": {"type": "array", "items": {"$ref": "#/definitions/port"}},
        "expose": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}